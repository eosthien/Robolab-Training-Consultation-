<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Customer Reply Helper</title>
<style>
  :root {
    --bg: #fafaf9;
    --card: #ffffff;
    --ink: #2d2a26;
    --muted: #7c756e;
    --line: #e8e4df;
    --accent: #2563eb;
    --accent-soft: #eff6ff;
    --ok: #16a34a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.6;
    padding: 32px 16px 64px;
  }
  .wrap { max-width: 760px; margin: 0 auto; }
  header { text-align: center; margin-bottom: 32px; }
  header h1 { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; }
  header p { color: var(--muted); font-size: 0.95rem; margin-top: 6px; }

  .section {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px;
    margin-bottom: 22px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.03);
  }
  .section h2 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 14px;
  }

  /* Question picker */
  .q-list { display: flex; flex-direction: column; gap: 10px; }
  .q-item {
    text-align: left;
    background: #fdfdfc;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .q-item:hover { border-color: var(--accent); }
  .q-item.active {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .q-item .q-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 4px;
    letter-spacing: 0.05em;
  }
  .q-item.active .q-tag { color: var(--accent); }

  /* Reply writer */
  .selected-q {
    background: #f5f4f2;
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    padding: 12px 14px;
    font-style: italic;
    color: var(--ink);
    font-size: 0.92rem;
    margin-bottom: 14px;
  }
  .selected-q strong {
    display: block;
    font-style: normal;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 4px;
  }
  textarea {
    width: 100%;
    min-height: 140px;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: #fff;
    resize: vertical;
    outline: none;
    transition: border-color 0.15s;
  }
  textarea:focus { border-color: var(--accent); }
  .counter {
    text-align: right;
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 6px;
  }

  /* Example replies */
  .ex-list { display: flex; flex-direction: column; gap: 12px; }
  .ex-card {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    background: #fdfdfc;
  }
  .ex-card h3 {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 6px;
    letter-spacing: 0.04em;
  }
  .ex-card p { font-size: 0.92rem; }
  .hint {
    margin-top: 14px;
    font-size: 0.82rem;
    color: var(--muted);
    text-align: center;
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Customer Reply Helper</h1>
    <p>Practice writing polite English replies to common customer questions</p>
  </header>

  <!-- SECTION 1: Question Picker -->
  <section class="section">
    <h2>1 · Question Picker</h2>
    <div class="q-list" id="questionList"></div>
  </section>

  <!-- SECTION 2: Reply Writer -->
  <section class="section">
    <h2>2 · Reply Writer</h2>
    <div class="selected-q" id="selectedQuestion"></div>
    <textarea id="replyBox" placeholder="Write your polite reply here..."></textarea>
    <div class="counter"><span id="charCount">0</span> characters</div>
  </section>

  <!-- SECTION 3: Example Replies -->
  <section class="section">
    <h2>3 · Example Replies</h2>
    <div class="ex-list" id="exampleList"></div>
    <div class="hint">Compare your draft above with these examples. Note the polite tone and clear next steps.</div>
  </section>
</div>

<script>
  // ----- Sample data (fictional, Malaysia-specific) -----
  const questions = [
    {
      tag: "Delivery",
      text: "Assalamualaikum, I ordered a raya cookie hamper from your Kajang branch on Monday and it still hasn't arrived. Raya is in two days! Can you check my delivery status please?",
      examples: [
        {
          title: "Warm & Reassuring",
          body: "Assalamualaikum and thank you for reaching out, Madam. We're truly sorry your hamper hasn't arrived yet, especially with Raya so close. We have checked with our courier and your parcel is scheduled for delivery tomorrow morning. We'll also send you the tracking link via WhatsApp right away. Thank you so much for your patience."
        },
        {
          title: "Apologetic & Action-Oriented",
          body: "Hello, thank you for letting us know, and we sincerely apologise for the delay. We have escalated your order to our Kajang branch team, and they will contact you today with an updated delivery time. If it does not reach you by tomorrow, we will arrange a full replacement at no charge. We appreciate your understanding."
        },
        {
          title: "Short & Polite",
          body: "Hi, we're very sorry for the delay with your Raya hamper. Our team is checking with the courier now and will update you within a few hours. Thank you for your patience, and Selamat Hari Raya in advance!"
        }
      ]
    },
    {
      tag: "Payment",
      text: "Hi, I tried to pay using FPX through Maybank2u just now but the page showed an error after I entered my TAC. My order is still unpaid in the app. Did the payment go through? I don't want to be charged twice.",
      examples: [
        {
          title: "Clear & Reassuring",
          body: "Hello, thank you for checking with us, and we completely understand your concern. We have reviewed your order and no payment was received on our side, so you will not be charged twice. Sometimes FPX payments do not complete if the confirmation page times out. Please feel free to try again, and if you notice any duplicate charge in your Maybank2u statement, just send us a screenshot and we will assist you immediately."
        },
        {
          title: "Empathetic & Detailed",
          body: "Hi there, thank you for reaching out so quickly, and we're sorry for the worry this has caused. Based on our records, the transaction did not go through, so your order remains unpaid and no deduction should appear. If your bank shows a pending amount, it will usually be released within three working days. Please try making the payment again, and let us know if you face the same error — we're happy to help."
        }
      ]
    },
    {
      tag: "Refund",
      text: "Hello, I bought a blender from your store in Mid Valley last Saturday, but when I got home it was making a strange noise and the blade doesn't spin properly. Can I get a refund or exchange? I have the receipt.",
      examples: [
        {
          title: "Helpful & Straightforward",
          body: "Hello, thank you for letting us know, and we're sorry to hear about the faulty blender. Yes, you're welcome to bring it back to our Mid Valley store with the receipt within seven days of purchase for either a one-to-one exchange or a full refund, whichever you prefer. Do also bring the original box and accessories if you still have them. We apologise again for the inconvenience."
        },
        {
          title: "Apologetic & Accommodating",
          body: "Hi, we're very sorry that your new blender isn't working properly — that must be frustrating. Since you have the receipt and you're within the exchange period, our Mid Valley team will be glad to process a refund or swap it for a new unit right away. Just mention this conversation at the counter and ask for the supervisor on duty. Thank you for your patience, and sorry again for the trouble."
        },
        {
          title: "Short & Polite",
          body: "Hello, we're sorry about the faulty blender. Yes, please bring the item and receipt to our Mid Valley store and we'll arrange an exchange or refund for you on the spot. Thank you for letting us know!"
        }
      ]
    }
  ];

  // ----- State (nothing is saved between visits) -----
  let selectedIndex = 0;
  let draft = "";

  // ----- Elements -----
  const questionList = document.getElementById("questionList");
  const selectedQuestionEl = document.getElementById("selectedQuestion");
  const replyBox = document.getElementById("replyBox");
  const charCount = document.getElementById("charCount");
  const exampleList = document.getElementById("exampleList");

  // ----- SECTION 1: Question Picker -----
  function renderQuestions() {
    questionList.innerHTML = "";
    questions.forEach((q, i) => {
      const btn = document.createElement("button");
      btn.className = "q-item" + (i === selectedIndex ? " active" : "");
      const tag = document.createElement("span");
      tag.className = "q-tag";
      tag.textContent = q.tag;
      const text = document.createElement("div");
      text.textContent = q.text;
      btn.appendChild(tag);
      btn.appendChild(text);
      // FEATURE 1 & 3: tapping a question selects it and updates everything
      btn.addEventListener("click", () => selectQuestion(i));
      questionList.appendChild(btn);
    });
  }

  function selectQuestion(i) {
    selectedIndex = i;
    draft = "";            // fresh draft for the new question
    renderQuestions();     // update picker highlight
    renderSelected();      // FEATURE 1: question appears in reply area
    renderExamples();      // FEATURE 3: examples switch to match
    replyBox.focus();
  }

  // ----- SECTION 2: Reply Writer -----
  function renderSelected() {
    const q = questions[selectedIndex];
    selectedQuestionEl.innerHTML = "";
    const label = document.createElement("strong");
    label.textContent = "Customer Question (Selected)";
    const text = document.createElement("div");
    text.textContent = '"' + q.text + '"';
    selectedQuestionEl.appendChild(label);
    selectedQuestionEl.appendChild(text);
    replyBox.value = draft;
    charCount.textContent = String(draft.length);
  }

  // FEATURE 2: typing updates the draft and count immediately
  replyBox.addEventListener("input", () => {
    draft = replyBox.value;
    charCount.textContent = String(draft.length);
  });

  // ----- SECTION 3: Example Replies -----
  function renderExamples() {
    const q = questions[selectedIndex];
    exampleList.innerHTML = "";
    q.examples.forEach(ex => {
      const card = document.createElement("div");
      card.className = "ex-card";
      const h = document.createElement("h3");
      h.textContent = "Example: " + ex.title;
      const p = document.createElement("p");
      p.textContent = ex.body;
      card.appendChild(h);
      card.appendChild(p);
      exampleList.appendChild(card);
    });
  }

  // ----- Initial render (app never opens empty) -----
  renderQuestions();
  renderSelected();
  renderExamples();
</script>
</body>
</html>
